{
    // i18n настройки
   "i18n-ally.localesPaths": [
      "public/locales",
      "src/shared/config/i18n"
   ],
   "i18n-ally.extract.ignoredByFiles": {
      "src/pages/MainPage/ui/MainPage.tsx": [
         "Главная страница"
      ]
   },
   "i18n-ally.extract.ignored": [
      "Главная страница"
   ],
   "i18n-ally.keystyle": "nested",

    
  // TypeScript/JavaScript настройки
  "typescript.format.insertSpaceAfterOpeningAndBeforeClosingTemplateStringBraces": false,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingTemplateStringBraces": false,

  // Форматирование и сохранение
"editor.formatOnSave": true,
"editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
       "source.fixAll.stylelint": "explicit"
      },

// Stylelint настройки
"[scss]": {
   "editor.defaultFormatter": "stylelint.vscode-stylelint",
   "editor.formatOnSave": true
},
"[css]": {
"editor.defaultFormatter": "stylelint.vscode-stylelint",
"editor.formatOnSave": true
},
"css.validate": false,
"less.validate": false,
"scss.validate": false,
"stylelint.enable": true,
"stylelint.validate": [
"css",
"scss"
],

  // ESLint настройки - Проверяет качество кода, находит баги, исправляет ошибки логики
  "eslint.enable": true,
"eslint.options": { "overrideConfigFile": "./.eslintrc.js" },
"eslint.validate": [
"javascript",
"javascriptreact",
"html",
"typescript",
"typescriptreact"
],
"eslint.format.enable": false, // Важно: отключаем форматирование ESLint,
//Только находит и исправляет ошибки, Prettier из глоабльных: Отвечает за форматирование 
//(отступы, кавычки, переносы строк) и не конфликтуют.

"auto-rename-tag.activationOnLanguage": ["*"], //Автом. переименовывает парный HTML/JSX тег
"git.autofetch": true,
"material-icon-theme.activeIconPack": "react_redux",
"editor.stickyScroll.enabled": true,
"workbench.colorCustomizations": {
"terminal.foreground": "#260e88",
"terminalCursor.background": "#0000ff48",
"terminalCursor.foreground": "#10c9de"
},
"cSpell.words": [
   "ВИНДОУС",
   "стейта",
   "languagedetector",
   "shch"
],


}

