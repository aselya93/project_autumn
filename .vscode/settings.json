{
   "i18n-ally.localesPaths": [
      "public/locales",
      "src/shared/config/i18n"
   ],
   "i18n-ally.extract.ignoredByFiles": {
      "src/pages/MainPage/ui/MainPage.tsx": [
         "Главная страница"
      ]
   },
   "i18n-ally.extract.ignored": [
      "Главная страница"
   ],
   "i18n-ally.keystyle": "nested",

   {
      "terminal.integrated.sendKeybindingsToShell": true,
      "workbench.iconTheme": "material-icon-theme",
      "auto-rename-tag.activationOnLanguage": ["*"],
      "editor.formatOnSave": false,
      "git.autofetch": true,
      "material-icon-theme.folders.color": "#26a69a",
      "material-icon-theme.files.color": "#26a69a",
      "material-icon-theme.activeIconPack": "react_redux",
      "editor.stickyScroll.enabled": true,
      "workbench.preferredLightColorTheme": "Default Dark Modern",
      "workbench.colorCustomizations": {
      "terminal.foreground": "#2fae9b",
      "terminalCursor.background": "#0000ff48",
      "terminalCursor.foreground": "#0fc6db"
      },
      "workbench.colorTheme": "Material Theme",
      "githubIssues.queries": [
      {
      "label": "My Issues",
      "query": "default"
      },
      {
      "label": "Created Issues",
      "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
      },
      {
      "label": "Recent Issues",
      "query": "state:open repo:${owner}/${repository} sort:updated-desc"
      }
      ],
      "githubPullRequests.createOnPublishBranch": "never",
      "workbench.settings.applyToAllProfiles": [
      
      ],
      "eslint.enable": true,
      "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
      },
      "eslint.options": { "overrideConfigFile": "./.eslintrc.js" },
      "eslint.nodePath": "./node_modules",
      "eslint.validate": [
      "javascript",
      "javascriptreact",
      "html",
      "typescript",
      "typescriptreact"
      ],
      "eslint.codeActionsOnSave.rules": null,
      
}